# Firebase Admin SDK — set all of these in Railway dashboard
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...
FIREBASE_STORAGE_BUCKET=your-bucket
FIREBASE_DATABASE_URL=
FIREBASE_API_KEY=

# ---------- Google Gemini AI ----------
# Model used by all AI features (chat, plans, mood, budget, doctor).
# Get a key at https://aistudio.google.com/apikey  — never commit a real key.
GEMINI_ENABLED=true
GEMINI_API_KEY=
# Tracks the newest Flash-Lite model automatically. Pin a version (e.g. gemini-3.1-flash-lite) if you prefer a fixed model.
GEMINI_MODEL=gemini-flash-lite-latest
# Request timeout in seconds (prevents hangs when the API is unreachable).
GEMINI_TIMEOUT=60

# CORS — comma-separated origins or "*"
CORS_ORIGINS=*

# ---------- USDA FoodData Central ----------
# Nutrition data source for the Scan pipeline. Get a key at
# https://fdc.nal.usda.gov/api-key-signup.html — never commit a real key.
USDA_API_KEY=

# ---------- Email verification ----------
# Verification uses a 6-digit numeric code emailed to the user.
# Public base URL used for client fallbacks (no trailing slash).
# The code defaults to http://127.0.0.1:8000 for local development - set the
# public URL (e.g. https://bitewise-app-production-ca6b.up.railway.app) in production.
APP_BASE_URL=https://bitewise-app-production-ca6b.up.railway.app
# How long a verification code stays valid (minutes).
VERIFY_OTP_TTL_MINUTES=10
# Minimum wait between resend requests (seconds).
VERIFY_RESEND_COOLDOWN_SECONDS=60
# Maximum wrong-code attempts before the code is invalidated (must resend).
VERIFY_OTP_MAX_ATTEMPTS=5
# ---------- Email verification (Gmail API) ----------
# Verification uses a 6-digit numeric code emailed to the user. Delivery is
# done through the Gmail API over HTTPS (users.messages.send) using Google's
# official Python API client, OAuth2 scope https://www.googleapis.com/auth/gmail.send.
# Credentials are read from environment variables only - NEVER commit real values.
# Get the client id/secret from Google Cloud Console (project nutrilens-ai-fd9fb)
# and obtain a refresh token for the fixed sender account (mybitewise@gmail.com).
# When any of the three is missing the app CANNOT send emails: signup/resend
# fail with a clear message instead of pretending an email was sent.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The From address is fixed to the authenticated sender (mybitewise@gmail.com).

# ---------- AI Customer Support (optional) ----------
# Reads incoming mail and auto-replies inside the same Gmail thread.
# IMPORTANT: reading the inbox needs a refresh token granted with the
# gmail.modify scope. The OTP token above is gmail.send-only, so grant the
# same Google Cloud OAuth client an additional refresh token for
# mybitewise@gmail.com with scope https://www.googleapis.com/auth/gmail.modify
# and put it here. This is REQUIRED for the support inbox to work.
GMAIL_SUPPORT_REFRESH_TOKEN=
# Comma-separated emails allowed to open the support dashboard
# (doctor/admin account types are always allowed).
SUPPORT_STAFF_EMAILS=
# Poll the inbox automatically in the background (true/false).
SUPPORT_POLL_ENABLED=true
# Seconds between inbox polls (min 10).
SUPPORT_POLL_INTERVAL_SECONDS=60

# ---------- Paymob Payment Integration (Unified Checkout / Intention API) ----------
# Paymob credentials - NEVER commit real values
# Get these from https://developers.paymob.com/paymob-docs/integration-paths/apis
# and Paymob Dashboard: Settings -> Account Info, Developers -> Payment Integrations
# For new Intention API (preferred):
#   PAYMOB_SECRET_KEY = API Secret Key (used as Authorization: Token <SECRET_KEY> for POST /api/intention/)
#   PAYMOB_PUBLIC_KEY = Public Key (used as ?publicKey= in unifiedcheckout URL)
#   PAYMOB_HMAC_SECRET = HMAC Secret (for webhook verification, SHA-512 on obj)
#   PAYMOB_INTEGRATION_ID = Integration ID (payment_methods: [integration_id])
#   PAYMOB_BASE_URL = Paymob API base (https://accept.paymob.com for Egypt)
# Legacy vars (PAYMOB_API_KEY / PAYMOB_IFRAME_ID) still supported for backwards compatibility
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_BASE_URL=https://accept.paymob.com
# Legacy fallback (old auth token + order + payment_key flow):
PAYMOB_API_KEY=
PAYMOB_IFRAME_ID=
# Webhook base URL - must be publicly accessible HTTPS endpoint
# Intention notification_url: PAYMOB_WEBHOOK_BASE_URL/payments/paymob/callback
# Legacy: PAYMOB_WEBHOOK_BASE_URL/payments/webhook
PAYMOB_WEBHOOK_BASE_URL=
# Sandbox mode (true/false) - use Paymob test credentials when true
PAYMOB_SANDBOX=true

# ---------- Unsplash (Dynamic Food Images) ----------
# Official Unsplash API for fetching food images based on meal names.
# Get a key at https://unsplash.com/developers — never commit a real key.
UNSPLASH_ACCESS_KEY=
